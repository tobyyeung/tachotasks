rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the Admin SDK used by calendarAuth can access these documents.
    match /_calendarCredentials/{uid} {
      allow read, write: if false;
    }
    // Preserve the project's existing access to each user's nested documents.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
